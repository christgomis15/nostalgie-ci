ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/.../exec

# Secret partagé avec le webhook Apps Script (propriete de script ADMIN_WEBHOOK_SECRET,
# meme valeur des deux cotes) - protege les actions admin_* contre un appel direct
# non authentifie sur l'URL du webhook, en plus du mot de passe du panneau /admin
GOOGLE_SHEET_WEBHOOK_SECRET=

# Page d'administration (/admin) — choisissez un mot de passe fort
ADMIN_PASSWORD=

# Stockage des images uploadées depuis /admin — ajouté automatiquement par
# Vercel quand vous activez "Blob" dans Storage sur le dashboard du projet
BLOB_READ_WRITE_TOKEN=

# Newsletter (/admin/newsletter) — clé API Brevo (app.brevo.com > Parametres
# SMTP & API > Cles API > Generer une nouvelle cle API)
BREVO_API_KEY=